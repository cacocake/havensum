{
  "name": "havensum",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.native.js",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --experimental-test-module-mocks --test tests/*.test.js tests/native/*.test.js",
    "test:browser": "playwright test",
    "test:coverage": "node --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.js tests/native/*.test.js",
    "test:all": "npm run test:coverage && npm run test:browser",
    "android": "expo start --android",
    "check:android": "expo export --platform android --output-dir android-bundle",
    "assets:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "buffer": "^6.0.3",
    "exceljs": "^4.4.0",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.9",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "lucide-react": "^1.74.0",
    "lucide-react-native": "^1.74.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5",
    "expo-crypto": "~15.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
